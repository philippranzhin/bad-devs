{
  "name": "bad-devs-engine",
  "version": "1.0.0",
  "description": "Bad Devs RPG Game Engine - Core game logic and models",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rpg",
    "game-engine",
    "typescript",
    "card-game",
    "bad-devs"
  ],
  "author": "Philipp Ranzhin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philippranzhin/bad-devs.git",
    "directory": "GameEngine"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
